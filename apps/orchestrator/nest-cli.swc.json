{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": false,
  "sourceRoot": "apps/orchestrator/src",
  "entryFile": "main",
  "language": "ts",
  "compilerOptions": {
    "manualRestart": true,
    "tsConfigPath": "apps/orchestrator/tsconfig.swc.json",
    "webpack": false,
    "deleteOutDir": false,
    "typeCheck": false,
    "builder": {
      "type": "swc",
      "options": {
        "swcrcPath": "scripts/dev/swc.json",
        "outDir": ".dev-state/swc/orchestrator",
        "filenames": [
          "apps/orchestrator/src",
          "libraries/helpers/src",
          "libraries/nestjs-libraries/src",
          "apps/backend/src"
        ],
        "stripLeadingPaths": false,
        "sync": true,
        "extensions": [
          ".ts",
          ".js"
        ],
        "copyFiles": false,
        "deleteDirOnStart": false
      }
    },
    "assets": [],
    "watchAssets": false,
    "plugins": []
  }
}
