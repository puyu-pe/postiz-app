# Synthetic local-only defaults. Copy to ignored .dev.env.local and edit privately.
# Literal KEY=value data only; no shell expansion, escapes, interpolation, or multiline values.
# Replace JWT_SECRET with a private secret before authenticated app use; never commit it.
LIGHT_POSTGRES_USER=postiz_light
LIGHT_POSTGRES_PASSWORD=postiz-light-local-only
LIGHT_POSTGRES_DB=postiz_light
LIGHT_POSTGRES_PORT=15433
LIGHT_REDIS_PORT=6380
LIGHT_TEMPORAL_PORT=7234
LIGHT_TEMPORAL_NAMESPACE=default
DATABASE_URL=postgresql://postiz_light:postiz-light-local-only@127.0.0.1:15433/postiz_light
REDIS_URL=redis://127.0.0.1:6380/0
TEMPORAL_ADDRESS=127.0.0.1:7234
TEMPORAL_NAMESPACE=default
TEMPORAL_TLS=false
TEMPORAL_API_KEY=
PORT=3000
ORCHESTRATOR_PORT=3002
FRONTEND_URL=http://localhost:4200
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000
BACKEND_INTERNAL_URL=http://localhost:3000
MAIN_URL=http://localhost:4200
NEXT_PUBLIC_OVERRIDE_BACKEND_URL=http://localhost:3000
STORAGE_PROVIDER=local
UPLOAD_DIRECTORY=var/uploads
NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY=./uploads
JWT_SECRET=replace-with-private-development-secret
NOT_SECURED=
